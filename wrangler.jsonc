{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard exactly, or Workers Builds will refuse to deploy.
  "name": "svarupa-studio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The site is served straight from the repository root; .assetsignore keeps non-site files from being published.
    "directory": ".",
    "binding": "ASSETS"
  },
  // Sends commission enquiries through Cloudflare Email Routing. No destination is fixed here so the artist's
  // address stays out of the repository; it comes from the ARTIST_EMAIL secret and must be a verified destination.
  "send_email": [{ "name": "SEND_EMAIL" }]
  // ARTIST_EMAIL, SENDER_EMAIL, TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY are secrets set in the dashboard
  // (or .dev.vars locally). Never add them here.
}
